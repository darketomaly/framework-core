:root {
    --color-text-paragraph: rgb(255, 255, 255);
    --color-element-panel: rgb(0, 0, 0);
}

Label {
    font-size: 16px;
    color: var(--color-text-paragraph);
    -unity-font-definition: url("project://database/Assets/com.darketomaly.framework.core/Samples/UITK/Fonts%20&%20Materials/Rajdhani-Regular%20SDF.asset?fileID=11400000&guid=bda95b7deb663e64d8bbcd2304dc0efd&type=2#Rajdhani-Regular SDF");
}

.main_panel {
    background-color: var(--color-element-panel);
}
